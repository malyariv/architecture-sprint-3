@startuml

title "Теплый Дом" Context Diagram

top to bottom direction

!include <C4/C4_Container>
skinparam actorStyle Hollow
: Клиент : as client
: Сотрудник : as admin

System_Boundary(web, "Система теплого дома") {
  Container(web_app, "Монолитное приложение", "Java, k8s, Postgres", "Позволяет получеть данные с датчиков и изменить темературу на реле")
}

System_Boundary(device, "Датчик") {
  Container(tmpdevice, "Реле управления температурой", "Позволяет получеть данные с датчиков и изменить темературу на реле")
  Container(sensor, "Датчик температуры", "Позволяет получеть данные с датчиков и изменить темературу на реле")
}

Rel(client, web_app, "Вкл/выкл   xc", "HTTPS")
Rel(admin, web_app, "Добавляет новое устройство", "HTTPS")
Rel(web, device, "Вкл/выкл устройства, изменение температуры, получение данных", "HTTPS")

@enduml